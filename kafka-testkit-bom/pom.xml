<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Sin parent a propósito: así el BOM publicado solo gestiona los módulos de kafka-testkit
    y no arrastra las versiones de terceros del POM padre.
  -->
  <groupId>io.github.volumidev</groupId>
  <artifactId>kafka-testkit-bom</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>kafka-testkit :: BOM</name>
  <description>Bill of Materials con las versiones alineadas de los módulos de kafka-testkit.</description>
  <url>https://github.com/VolumiDev/tooling-kafka</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <revision>0.1.0-SNAPSHOT</revision>
    <project.build.outputTimestamp>2026-09-25T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.volumidev</groupId>
        <artifactId>kafka-testkit-core</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.volumidev</groupId>
        <artifactId>kafka-testkit-schema-registry</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.volumidev</groupId>
        <artifactId>kafka-testkit-karate</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>io.github.volumidev</groupId>
        <artifactId>kafka-testkit-testcontainers</artifactId>
        <version>${revision}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Sin formatos que aplicar: solo para que `mvnw spotless:apply` resuelva el prefijo en todo el reactor -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.2</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.8.0</version>
        <configuration>
          <flattenMode>bom</flattenMode>
          <updatePomFile>true</updatePomFile>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
