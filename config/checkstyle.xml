<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Reglas de estilo y diseño de kafka-testkit.
  El formato (indentación, llaves, longitud de línea) lo aplica Spotless con google-java-format (AOSP),
  así que aquí solo hay reglas que el formateador no cubre.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- La implementación (paquetes internal) no exige Javadoc -->
  <module name="SuppressionSingleFilter">
    <property name="checks" value="MissingJavadoc(Type|Method)"/>
    <property name="files" value="[\/]internal[\/]"/>
  </module>

  <module name="NewlineAtEndOfFile">
    <property name="lineSeparator" value="lf_cr_crlf"/>
  </module>

  <module name="TreeWalker">
    <!-- Imports -->
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>
    <module name="IllegalImport"/>

    <!-- Nombres -->
    <module name="PackageName">
      <property name="format" value="^io\.github\.volumidev\.kafkatestkit(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="ConstantName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>

    <!-- Javadoc de la API pública -->
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
      <property name="allowMissingPropertyJavadoc" value="true"/>
      <property name="tokens" value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF, COMPACT_CTOR_DEF"/>
    </module>
    <module name="InvalidJavadocPosition"/>

    <!-- Diseño -->
    <module name="OneTopLevelClass"/>
    <module name="FinalClass"/>
    <module name="HideUtilityClassConstructor"/>
    <module name="EqualsHashCode"/>
    <module name="NeedBraces"/>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <!-- Logs solo con slf4j -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="System\.(out|err)\.print"/>
      <property name="message" value="Usa slf4j en lugar de System.out/System.err."/>
      <property name="ignoreComments" value="true"/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="format" value="\.printStackTrace\(\)"/>
      <property name="message" value="No uses printStackTrace(); registra la excepción con slf4j."/>
      <property name="ignoreComments" value="true"/>
    </module>
  </module>
</module>
