<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.volumidev</groupId>
    <artifactId>kafka-testkit-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>kafka-testkit-it</artifactId>

  <name>kafka-testkit :: Integration tests</name>
  <description>Tests de integraciÃ³n (JUnit + Testcontainers) y suite Karate de kafka-testkit. No se publica.</description>

  <properties>
    <!-- Los *IT solo se ejecutan con -Pit (requieren Docker a partir de F3) -->
    <skipITs>true</skipITs>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <maven.source.skip>true</maven.source.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.volumidev</groupId>
      <artifactId>kafka-testkit-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.volumidev</groupId>
      <artifactId>kafka-testkit-schema-registry</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.volumidev</groupId>
      <artifactId>kafka-testkit-karate</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.volumidev</groupId>
      <artifactId>kafka-testkit-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.karatelabs</groupId>
      <artifactId>karate-junit6</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>it</id>
      <properties>
        <skipITs>false</skipITs>
      </properties>
    </profile>
  </profiles>
</project>
